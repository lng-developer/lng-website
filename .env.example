# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== Database =====
MONGO_URI=mongodb://localhost:27017/lng_db
DB_NAME=lng_db

# ===== Redis (for BullMQ & cache) =====
REDIS_URL=redis://localhost:6379

# ===== Auth =====
JWT_SECRET=your_very_secret_key

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Smarty (Address Validation) =====
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# ===== Vendor: Grabink =====
GRABINK_API_KEY=

# ===== Vendor: Merchfox =====
MERCHFOX_TOKENKEY=
MERCHFOX_SECRET=

# ===== Vendor: Mangotee =====
MANGOTEE_ENDPOINT=https://v3.mangoteeprints.com/api/public/v1/orders
MANGOTEE_API_KEY=

# ===== Vendor: Printway =====
PRINTWAY_ENDPOINT=https://apis.printway.io/v3/order/create-new-order
PRINTWAY_ACCESS_TOKEN=
PRINTWAY_PAID_ENDPOINT=https://apis.printway.io/v3/order/paid

# ===== Vendor: Merchize =====
MERCHIZE_ACCESS_TOKEN=

# ===== Vendor: LNG =====
LNG_API_KEY=
LNG_ENDPOINT=https://api-fulfillment.lngmerch.co/api/orders

# ===== Wasabi S3 =====
WASABI_REGION=ap-southeast-1
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_BUCKET=lng-psd
WASABI_PUBLIC=false

# ===== Logging =====
PERSIST_LOGS=1
LOG_TTL_DAYS=2
MAX_RT_LOGS=5000
LOG_LEVEL=info
LOG_DIR=logs
